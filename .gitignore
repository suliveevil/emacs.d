# ── macOS 系统文件 ──────────────────────────────────
.DS_Store
._.DS_Store

# ── Emacs 运行期产物 ────────────────────────────────
*.elc
*~
\#*
.#*
.*.lock
*_flymake.el
/auto-save-list
/.emacs.desktop
/.mc-lists.el
/.session
/session.*
/.org-id-locations
/org-clock-save.el
/org-roam.db
/org-persist
/assets/uptime.org

# ── 包管理器：可由 package-selected-packages 重建 ────
/elpa/
/eln-cache/
/var/
/custom.el
package-quickstart.el

# ── 本地状态：不入库，换机器不该带过去 ──────────────
*.eld
recentf
history
network-security.data
/ac-comphist.dat
/.org-src-babel
/.workbuddy

# ── 内置功能的状态目录（用到时才生成，先占位）───────
transient/
eshell/

# ── 备份与临时文件 ──────────────────────────────────
*.bak*
*.log
/test.html

# keyfreq 的日/月归档：与 assets/keyfreq-log 一起纳入版本控制
!/assets/keyfreq-days/*.log
