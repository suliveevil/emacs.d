(((deadgrep-mode my/grep-org-files "RET") . 1)
((fundamental-mode nil "C-c g RET") . 1)
((fundamental-mode nil "C-c o") . 1)
((minibuffer-mode my/grep-org-files "C-c g o") . 1)
((fundamental-mode delete-window "C-x 0") . 1)
((org-mode kill-ring-save "s-c") . 1)
((org-mode mouse-drag-region "<down-mouse-1>") . 3)
((org-mode mouse-set-point "<mouse-1>") . 2)
((org-mode mouse-set-region "<drag-mouse-1>") . 1)
((org-mode ns-open-file-select-line "<ns-open-file-line>") . 1)
((org-mode org-delete-backward-char "DEL") . 1)
((org-mode right-char "<right>") . 1)
)